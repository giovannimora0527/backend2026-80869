# ============================================================
#  Plantilla de variables de entorno para Docker Compose
# ============================================================
#
#  Copie este archivo como ".env" (en la misma carpeta que
#  docker-compose.yml) y complete los valores. Docker Compose lo lee
#  automaticamente al ejecutar "docker compose up".
#
#  Estas variables configuran el envio de correo (codigo OTP del login
#  de doble factor). Sin ellas, el sistema arranca pero no podra enviar
#  el codigo de verificacion.
#
#  No suba el archivo ".env" real al repositorio: contiene credenciales.
# ============================================================

# Servidor SMTP (Gmail por defecto)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# Cuenta que envia los correos y su contrasena de aplicacion de Gmail
# (no es la contrasena normal: se genera en la configuracion de la
#  cuenta de Google, en "Contrasenas de aplicaciones").
MAIL_USERNAME=correo_de_envio@gmail.com
MAIL_PASSWORD=contrasena_de_aplicacion

# Correo de notificaciones (opcional)
MAIL_TO=correo_destino@gmail.com

# Clave de firma del token JWT (opcional). Si no se define, se usa la
# clave por defecto del perfil docker.
# JWT_SECRET_ENV=su_clave_secreta_base64
